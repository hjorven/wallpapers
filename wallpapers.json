  "themes": [
    {
      "id": "officina",
      "name": "Officina",
      "tagline": "Planets over ancient buildings",
      "description": "Twelve 1-bit engravings in the style of the portfolio, one per accent colour. Each one pairs its own planet with a building from antiquity, floating solids and a cloud bank.",
      "packs": [
        {
          "device": "ipad-9",
          "zip": "downloads/officina-ipad.zip",
          "overviews": [
            {
              "label": "Overview landscape",
              "src": "themes/officina/ipad/overview-landscape.png"
            },
            {
              "label": "Overview portrait",
              "src": "themes/officina/ipad/overview-portrait.png"
            }
          ],
          "howto": [
            "Tap Landscape or Portrait, then hold the image and choose Save to Photos.",
            "In Safari, open a new tab, tap Edit at the bottom of the start page and turn on Background Image.",
            "Tap + and pick the wallpaper."
          ]
        }
      ]
    }
  ],
